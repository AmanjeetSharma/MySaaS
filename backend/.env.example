NODE_ENV=development

VERIFICATION_REQUIRED=false

LOG_LEVEL=debug
SERVICE_NAME=your_project_name

# Database Configuration
MONGO_URI=mongodb://localhost:27017/mysaas
DB_NAME=your_database_name
PORT=3000

# CORS and Client URL
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Configuration
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password

EMAIL_ENABLED=false
ENABLE_JOBS=true

# JWT Configuration
ACCESS_TOKEN_SECRET=your_random_access_token_secret
REFRESH_TOKEN_SECRET=your_random_refresh_token_secret
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# Google OAuth for authentication
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/providers/google/callback

# Google OAuth for state management
GOOGLE_OAUTH_STATE_SECRET=your_random_oauth_state_secret
GOOGLE_OAUTH_STATE_EXPIRY=10m
GOOGLE_REFRESH_TOKEN_ENCRYPTION_KEY=your_random_encryption_key_for_google_refresh_tokens

# Razorpay
RAZORPAY_KEY_ID=Your_Razorpay_Key_ID
RAZORPAY_KEY_SECRET=Your_Razorpay_Key_Secret
RAZORPAY_WEBHOOK_SECRET=Your_Razorpay_Webhook_Secret

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_OUTAGE_DURATION_MS=30000 #30 seconds for development, you can increase this for production according to your needs
REDIS_ERROR_LOG_THROTTLE_MS=30000 #30 seconds for development, you can increase this for production according to your needs

# Server shutdown
SERVER_SHUTDOWN_TIMEOUT_MS=60000 #60 seconds for development, you can increase this for production according to your needs