NODE_ENV=development

VERIFICATION_REQUIRED=false

MONGO_URI=mongodb://localhost:27017/mysaas
DB_NAME=your_database_name
PORT=3000

CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password

EMAIL_ENABLED=false
ENABLE_JOBS=true

ACCESS_TOKEN_SECRET=your_random_access_token_secret
REFRESH_TOKEN_SECRET=your_random_refresh_token_secret
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/providers/google/callback

GOOGLE_OAUTH_STATE_SECRET=your_random_oauth_state_secret
GOOGLE_OAUTH_STATE_EXPIRY=10m