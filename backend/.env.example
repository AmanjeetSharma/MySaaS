NODE_ENV=development

VERIFICATION_REQUIRED=false

LOG_LEVEL=debug
SERVICE_NAME=your_project_name

# Database Configuration
MONGO_URI=mongodb://localhost:27017/mysaas
DB_NAME=your_database_name
PORT=3000

# CORS and Client URL
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Configuration
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password

EMAIL_ENABLED=false
ENABLE_BACKGROUND_PROCESSING=true

# JWT Configuration
ACCESS_TOKEN_SECRET=your_random_access_token_secret
REFRESH_TOKEN_SECRET=your_random_refresh_token_secret
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# Google OAuth for authentication
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/providers/google/callback

# Google OAuth for state management
GOOGLE_OAUTH_STATE_SECRET=your_random_oauth_state_secret
GOOGLE_OAUTH_STATE_EXPIRY=10m
GOOGLE_REFRESH_TOKEN_ENCRYPTION_KEY=your_random_encryption_key_for_google_refresh_tokens

# Razorpay
RAZORPAY_KEY_ID=Your_Razorpay_Key_ID
RAZORPAY_KEY_SECRET=Your_Razorpay_Key_Secret
RAZORPAY_WEBHOOK_SECRET=Your_Razorpay_Webhook_Secret

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_OUTAGE_DURATION_MS=30000 #30 seconds for development, you can increase this for production according to your needs
REDIS_ERROR_LOG_THROTTLE_MS=30000 #30 seconds for development, you can increase this for production according to your needs

# Server shutdown
SERVER_SHUTDOWN_TIMEOUT_MS=60000 #60 seconds for development, you can increase this for production according to your needs

#Arcjet Configuration
ARCJET_API_KEY=your_arcjet_api_key


# Zoom OAuth for authentication
ZOOM_CLIENT_ID=your_zoom_oauth_client_id
ZOOM_CLIENT_SECRET=your_zoom_oauth_client_secret
ZOOM_REDIRECT_URI=for_development_you_will_need_to_use_a_tunnel_service_like_ngrok_or_localtunnel_to_expose_your_local_server_to_the_internet_for_zoom_oauth_callback
# Note: ZOOM requires a publicly accessible URL for the OAuth callback. You can use a service like cloudflared/ngrok to create a public URL that tunnels to your local development server. For example, if you run `ngrok http 3000`, it will give you a public URL like `https://abcd1234.ngrok.io`. You would then set your ZOOM_REDIRECT_URI to `https://abcd1234.ngrok.io/api/providers/zoom/callback` and also update the Zoom app settings in the Zoom App Marketplace to include this URL as a valid redirect URI.

# Zoom OAuth for state management
ZOOM_OAUTH_STATE_SECRET=your_random_zoom_oauth_state_secret
ZOOM_OAUTH_STATE_EXPIRY=10m
ZOOM_REFRESH_TOKEN_ENCRYPTION_KEY=your_random_encryption_key_for_zoom_refresh_tokens